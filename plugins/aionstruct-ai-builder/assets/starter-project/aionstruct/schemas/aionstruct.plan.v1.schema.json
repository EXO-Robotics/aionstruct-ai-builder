{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aionstruct.plan.v1",
  "title": "AIONSTRUCT Plan v1",
  "description": "Bounded semantic structure authoring which deterministically lowers to AIONSTRUCT Blueprint v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "size", "palette", "components", "world_grammar", "production_standard"],
  "properties": {
    "schema": { "const": "aionstruct.plan.v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "short_name": { "$ref": "#/$defs/alias" },
    "size": { "$ref": "#/$defs/size" },
    "origin": { "$ref": "#/$defs/point" },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": { "$ref": "#/$defs/alias" },
      "additionalProperties": { "$ref": "#/$defs/paletteEntry" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/foundation" },
          { "$ref": "#/$defs/room" },
          { "$ref": "#/$defs/opening" },
          { "$ref": "#/$defs/roof" },
          { "$ref": "#/$defs/stairRun" },
          { "$ref": "#/$defs/anchor" },
          { "$ref": "#/$defs/connector" }
        ]
      }
    },
    "meta": { "type": "object" },
    "world_grammar": { "const": "AIONSTRUCT_WORLD_GRAMMAR_V1" },
    "production_standard": { "const": "AIONSTRUCT_STRUCTURE_STANDARD_V1" },
    "rotation_policy": { "const": "none" },
    "mirror_policy": { "const": "mirror_none" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "not": { "const": "void" } },
    "stableName": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "point": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } },
    "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 1, "maximum": 64 } },
    "blockToken": {
      "type": "string",
      "anyOf": [{ "const": "void" }, { "$ref": "#/$defs/alias" }, { "$ref": "#/$defs/identifier" }]
    },
    "stateValue": { "oneOf": [{ "type": "boolean" }, { "type": "integer" }, { "type": "string", "maxLength": 256 }] },
    "states": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stateValue" } },
    "paletteEntry": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block"],
          "properties": {
            "block": { "$ref": "#/$defs/identifier" },
            "states": { "$ref": "#/$defs/states" },
            "version": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "comment": { "type": "string", "maxLength": 4096 },
    "depends": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableName" } },
    "common": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" },
        "kind": { "type": "string" },
        "depends_on": { "$ref": "#/$defs/depends" },
        "comment": { "$ref": "#/$defs/comment" }
      }
    },
    "foundation": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "from", "to", "block"],
          "properties": {
            "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "foundation" },
            "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
            "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" }, "block": { "$ref": "#/$defs/blockToken" }
          }
        }
      ]
    },
    "room": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "wall_block", "floor_block", "ceiling_block"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "room" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" },
        "wall_block": { "$ref": "#/$defs/blockToken" }, "floor_block": { "$ref": "#/$defs/blockToken" },
        "ceiling_block": { "$ref": "#/$defs/blockToken" }, "clear_block": { "$ref": "#/$defs/blockToken" }
      }
    },
    "opening": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "host", "depends_on", "opening_kind", "face", "y", "width", "height", "fill"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "opening" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "host": { "$ref": "#/$defs/stableName" }, "opening_kind": { "enum": ["doorway", "window", "arch"] },
        "face": { "$ref": "#/$defs/cardinal" }, "wall_z": { "type": "integer" }, "center_x": { "type": "integer" },
        "wall_x": { "type": "integer" }, "center_z": { "type": "integer" }, "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
        "fill": { "$ref": "#/$defs/blockToken" }, "lintel": { "$ref": "#/$defs/blockToken" }
      },
      "allOf": [
        {
          "if": { "properties": { "opening_kind": { "const": "arch" } }, "required": ["opening_kind"] },
          "then": { "required": ["lintel"] }
        },
        {
          "if": { "properties": { "face": { "enum": ["north", "south"] } }, "required": ["face"] },
          "then": {
            "required": ["wall_z", "center_x"],
            "not": { "anyOf": [{ "required": ["wall_x"] }, { "required": ["center_z"] }] }
          },
          "else": {
            "required": ["wall_x", "center_z"],
            "not": { "anyOf": [{ "required": ["wall_z"] }, { "required": ["center_x"] }] }
          }
        }
      ]
    },
    "roof": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "host", "depends_on", "from", "to", "axis", "block", "fill_gable"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "roof" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "host": { "$ref": "#/$defs/stableName" }, "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" },
        "axis": { "enum": ["x", "z"] }, "block": { "$ref": "#/$defs/blockToken" }, "fill_gable": { "$ref": "#/$defs/blockToken" }
      }
    },
    "stairRun": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "at", "steps", "facing", "block"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "stair_run" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "at": { "$ref": "#/$defs/point" }, "steps": { "type": "integer", "minimum": 1 },
        "facing": { "$ref": "#/$defs/cardinal" }, "block": { "$ref": "#/$defs/blockToken" }, "states": { "$ref": "#/$defs/states" }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "at", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "anchor" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "name": { "$ref": "#/$defs/stableName" }, "at": { "$ref": "#/$defs/point" },
        "type": { "$ref": "#/$defs/stableName" }, "facing": { "enum": ["none", "north", "south", "east", "west", "up", "down"] }
      }
    },
    "connector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "face", "origin", "width", "height", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableName" }, "kind": { "const": "connector" },
        "depends_on": { "$ref": "#/$defs/depends" }, "comment": { "$ref": "#/$defs/comment" },
        "name": { "$ref": "#/$defs/stableName" }, "face": { "$ref": "#/$defs/cardinal" },
        "origin": { "$ref": "#/$defs/point" }, "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }, "type": { "$ref": "#/$defs/stableName" }
      }
    },
    "cardinal": { "enum": ["north", "south", "east", "west"] }
  }
}
